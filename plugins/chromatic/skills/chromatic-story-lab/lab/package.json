{
  "name": "chromatic-story-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "storybook": "npm run storybook --workspace=@story-lab/notes",
    "build-storybook": "npm run build-storybook --workspace=@story-lab/notes",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify": "npm run test && npm run typecheck && npm run build-storybook && npm run test:browser"
  },
  "devDependencies": {
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/react-vite": "10.5.7",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "playwright": "1.54.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "storybook": "10.5.7",
    "typescript": "5.8.2",
    "vite": "6.3.5"
  }
}
